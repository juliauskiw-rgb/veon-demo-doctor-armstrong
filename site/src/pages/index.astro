---
import { getImage } from "astro:assets";
import Base from "../layouts/Base.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Problems from "../components/Problems.astro";
import FirstVisit from "../components/FirstVisit.astro";
import Trust from "../components/Trust.astro";
import Services from "../components/Services.astro";
import Centres from "../components/Centres.astro";
import Booking from "../components/Booking.astro";
import Footer from "../components/Footer.astro";
import MobileBar from "../components/MobileBar.astro";
import zal from "../assets/img/zal-trener.png";
import { centres, contacts } from "../data/clinic";

const og = await getImage({ src: zal, width: 680, format: "jpg" });

const ld = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "MedicalBusiness",
      "@id": "#org",
      name: "Doctor Armstrong",
      legalName: "ТОВ «Доктор Армстронг»",
      telephone: "+380676354554",
      email: contacts.email,
      sameAs: [contacts.instagram, contacts.facebook],
      areaServed: "Київ",
    },
    ...centres.map((c) => ({
      "@type": "MedicalClinic",
      name: `Doctor Armstrong, метро ${c.metro}`,
      parentOrganization: { "@id": "#org" },
      telephone: "+380676354554",
      address: { "@type": "PostalAddress", streetAddress: c.street, addressLocality: "Київ", addressCountry: "UA" },
      hasMap: c.map,
      openingHoursSpecification: [
        { "@type": "OpeningHoursSpecification", dayOfWeek: ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday"], opens: "08:00", closes: "20:00" },
        { "@type": "OpeningHoursSpecification", dayOfWeek: "Saturday", opens: "09:00", closes: "15:00" },
      ],
    })),
  ],
};
---
<Base
  lang="uk"
  title="Фізична реабілітація в Києві біля метро | Doctor Armstrong"
  description="Активна реабілітація з фізичним терапевтом у трьох центрах Києва: Лук'янівська, Іподром, Позняки. Консультація від 710 грн. Запис за телефоном або в Telegram."
  ogImage={og.src}
>
  <script is:inline slot="head" type="application/ld+json" data-rec="R-203" set:html={JSON.stringify(ld)} />
  <Header slot="header" />
  <Hero />
  <Problems />
  <FirstVisit />
  <Trust />
  <Services />
  <Centres />
  <Booking />
  <Footer slot="footer" />
  <MobileBar slot="footer" />
</Base>
